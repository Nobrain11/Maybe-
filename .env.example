# Copy this file to .env and fill in your values. Never commit .env to git.

# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=

# Optional: restrict the bot to only respond to your Telegram user ID
# (find yours by messaging @userinfobot)
ALLOWED_TELEGRAM_USER_ID=

# Robinhood Crypto API keys go here in Phase 2 - leave blank for now
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY=

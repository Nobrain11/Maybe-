# Copy this file to .env and fill in your values. Never commit .env to git.

# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=

# REQUIRED for the multi-user bot: encrypts every user's stored Robinhood
# credentials at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret and back it up - if you lose it, every connected user
# has to /connect again (there is no way to recover their stored keys
# without it).
BOT_MASTER_KEY=

# NOTE: there is no single ROBINHOOD_API_KEY here anymore. Each user
# provides their own Robinhood credentials via the /connect command in
# the bot itself, and those are stored encrypted per-user in bot.db.
